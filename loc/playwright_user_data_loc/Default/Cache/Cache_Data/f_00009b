        // This is a critical fallback for now.  Chrome and firefox use hls.js
        // and hls.js stiches together our .ts a/v segments without audio drift
        // but... safari native hls doesnt not :woman_facepalming:
        var is_safari = false,
            fallback_source,
            source_node;

        if (navigator.userAgent.indexOf('Safari') != -1
        && navigator.userAgent.indexOf('Chrome') == -1){
            // Remove the m3u8 source
            is_safari = true;
        }
        if(is_safari ){
            source_node = $(".media-playlist-video-player source[type='application/x-mpegURL']");
            fallback_source = source_node.clone();
            source_node.remove();
        } else if ($(".media-playlist-video-player source[type='application/x-mpegURL']").length) {
            // Remove the mp4 source if the player supports HLS
            source_node = $(".media-playlist-video-player source[type='video/mp4']");
            fallback_source = source_node.clone();
            source_node.remove();
        }

        // Copy the title attribute of the first video source element to the
        // video element because on safari if there is only one source element
        // safari will remove it an put the url directly into the video source
        // element, but not copy the title attribute (which we need for metrics)
        if (typeof fallback_source !== 'undefined' && fallback_source !== null) {
            $(fallback_source).parents(".media-playlist-audio-player, .media-playlist-video-player").attr(
                'title',
                fallback_source.attr('title')
            );
        }

        mediaelement = new MediaElementPlayer(mediaElement, {
            pluginPath: '/static/ui2/dist/js/mediaelement/',
            iconSprite: '/static/ui2/dist/js/mediaelement/mejs-controls.svg',
            audioVolume: 'vertical',
            stretching: 'none',
            toggleCaptionsButtonWhenOnlyOne: true,
            videoWidth: '100%',
            videoHeight: '100%',
            // currentMessage: '',
            // showPlaylist: true,
            // features: [
            //     //'playlist',
            //     //'prevtrack',
            //     //'nexttrack',
            //     'fullscreen',
            //     'playpause',
            //     'current',
            //     'progress',
            //     'duration',
            //     'volume'
            // ],
            success: function(media, node){
                container = $(media).parents('.media-playlist-container');
                player = node.player;

                // Bind all of our metrics tracking handlers
                var title = $('source', media).length ?
                    $('source', media).get(0).title:
                    $('video, audio', media).get(0).title;
                //UX.track_player(media, 'mediaElement', title, true); // Uncaught ReferenceError: UX is not defined

                // Dont know why but the player stretches out all the mejs__layers
                // with width: 100%; height: 100%
                //$('.mejs__poster', $(node).parents('.mejs__container')).attr('style', '');
                // fix for wave errors - adding an alt attribute for fallback poster image and hide the offscreen text
                $('.mejs__poster.mejs__layer img').attr('alt', '');

                // Bind all of our metrics tracking handlers
                media.addEventListener('loadedmetadata', function() {
                    //console.log('loadedmetadata %s', arguments);
                }, true);
                media.addEventListener('progress', function() {
                    //console.log('progress %s', arguments[0]);
                }, true);
                media.addEventListener('timeupdate', function() {
                    //console.log('timeupdate %s', arguments[0]);
                }, true);
                media.addEventListener('seeking', function() {
                    //console.log('seeking %s', arguments[0]);
                }, true);
                media.addEventListener('seeked', function() {
                    //console.log('seeked %s', arguments[0]);
                }, true);
                media.addEventListener('canplay', function() {
                    //console.log('canplay %s', arguments[0]);
                }, true);
                media.addEventListener('play', function() {
                    // console.log('play %s', arguments);
                    jQuery(document).trigger('video-player-play', [media, node]);
                }, true);
                media.addEventListener('playing', function() {
                    // console.log('playing %s', arguments);
                    // MP4's seem to overstretch, not sure why, unset node style
                    if (is_safari || $(".media-playlist-video-player source[type='video/mp4']").length){
                        $(node).attr('style', '');
                    }
                }, true);
                media.addEventListener('pause', function() {
                    //console.log('pause %s', arguments[0]);
                    jQuery(document).trigger('audio-player-pause', [media, node]);
                }, true);
                media.addEventListener('ended', function() {
                    var container = $(media).parents('.media-playlist-container'),
                        current_track = $('.mejs__playlist-selected', container)
                        all_tracks = $('.mejs__playlist-selector-list-item', container),
                        index = Number(current_track.data('playlist-index')) + 1;
                    if (all_tracks.length > index){
                        $(all_tracks.get(index)).trigger('click');
                    }
                }, true);
                media.addEventListener('volumechange', function() {
                    //console.log('volumechange %s', arguments[0]);
                }, true);
                media.addEventListener('captionschange', function() {
                    //console.log('captionschange %s', captionschange);
                }, true);

                setTimeout(function(){
                    $(document).trigger('media-player-ready', [media, node]);
                    if(callback){
                        callback(media, node);
                    }
                }, 100);

                // adding a classname to a flash player container
                $('.media-playlist-video-player div:has(embed)').addClass('flash-fallback-container');

                if(!player.isVideo){
                    /* playlist plug in used to do this bit
                    var title_element = '<div' +
                        '   class="mejs__playlist-current mejs__layer"' +
                        '   style="width:100%; height:100%">' +
