document.addEventListener("DOMContentLoaded", () => {
    let target = document.querySelectorAll('[data-file-path], [data-text-id], [data-text-services]');
    if(!target.length){return;}

    var file_path = document.querySelector('[data-file-path]').getAttribute('data-file-path'),
        text_id = document.querySelector('[data-text-id]').getAttribute('data-text-id'),
        text_services = document.querySelector('[data-text-services]').getAttribute('data-text-services'),
        text_url = text_services + "word-coordinates-service?format=tei2_xml&full_text=1&segment=",
        text_block = $(text_id),
        is_static = false;

    if(file_path.includes('/storage-services/')){
        file_path = file_path.split('/storage-services');
        if (file_path.length < 2){
            console.log('No storage-services url: ' + file_path);
            return;
        }
        file_path = file_path[1];
        text_url = text_url + file_path;
    } else if(file_path.includes('/streaming-services/') || file_path.includes('/static/')){
        text_url = file_path;
        is_static = true;
    } else {
        text_url = null;
    }

    if(!text_url){
        console.log('Unknown format for file_path: ' + file_path);
        return;
    }

    $.ajax({
        traditional: true,
        type: "GET",
        url: text_url,
        dataType: is_static ? "text" : "json",
        success: function(response){
            var transcript_text = is_static ?
                response :
                response[file_path].full_text;
            text_block.html(transcript_text);
        },
        error: function(response){
            console.log("Failed to load text: " + text_url);
        }
    });
