        if('on' == value){
            _formData.set(name, 'yes');
            value = 'yes';
        }
        if('off' == value){
            _formData.set(name, 'no');
            value = 'no';
        }
        if (name && value){
            $('#' + name + '-text').text(value);
            $('#' + name + '-submitted').show();
        }
    });
    formData.append('portal_form_key', PORTAL_FORM_KEY);

    $.ajax({
        url: '/portals/submit/form/' + PORTAL_FORM_URL + '/',
        data: formData,
        cache: false,
        contentType: false,
        processData: false,
        method: 'POST',
        type: 'POST', // For jQuery < 1.9
        success: function (response) {
            $('.submitting').addClass('hide');
            $('.form').addClass('hide');
            $('.received').removeClass('hide');
            $('.received').get(0).scrollIntoView();
            $('.received').get(0).focus();
        },
        error: function (response, message, http_error) {
            $('.submitting').addClass('hide');
            if(response && response.status && response.status == 403){
                alert_key_error();
            } else if(response && response.status && response.status == 400){
                $('.submission-error-message').text(
                    '(' + message + ') [' + http_error + ']'
                )
                $('.submission-error').removeClass('hide');
                $('.submission-error').get(0).scrollIntoView();
                $('.submission-error').get(0).focus();
                $('.form').removeClass('hide');
