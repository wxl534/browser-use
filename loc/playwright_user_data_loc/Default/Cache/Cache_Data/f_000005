          has_native_hls = hasNativeHLS();

    let title = source.title ?
        source.title :
        video.title;

    setTimeout(function(){
        try{
            UX.track_player(media, 'mediaElement', title, true);
        } catch(e){
            console.error('UX track_player error:%s', e);
        }
    }, 2000);

    let player_wrapper = media.closest('.video-player-wrapper'),
        container = media.closest('.mejs__container'),
        title_embed = media.querySelector('.title-embed'),
        poster_container,
        poster_image,
        video_label;

    // Replace default audio label
    if (player_wrapper && container){
        video_label = player_wrapper.getAttribute('data-label');
        container.setAttribute('aria-label', video_label);
    }

    if (container){
        // Dont know why but the player stretches out all the mejs__layers
        // with width: 100%; height: 100%
        poster_container = container.querySelector('.mejs__poster');
        if (poster_container){
            poster_container.style = '';
            // fix for wave errors - adding an alt attribute for fallback
            // poster image and hide the offscreen text
            poster_image = poster_container.querySelector('img');
            if (poster_image){
                poster_image.setAttribute('alt', '');
            }
        }
    }

    // Event listeners
    media.addEventListener('play', function() {
        media.dispatchEvent(new Event('video-player-play'));
    }, true);

    media.addEventListener('pause', function() {
        if (title_embed){
            title_embed.classList.removeClass('playing');
        }
    }, true);

    media.addEventListener('playing', function() {
        // MP4's seem to overstretch, not sure why, unset node style
        if (has_native_hls || mp4_node){
            node.style = '';
        }
        if (title_embed){
            title_embed.classList.addClass('playing');
        }
    }, true);

    setTimeout(function(){
        media.dispatchEvent(new Event('media-player-ready'));
    }, 100);
}
