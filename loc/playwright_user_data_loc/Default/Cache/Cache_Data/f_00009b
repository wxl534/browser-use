document.addEventListener("DOMContentLoaded", () => {

    function setSessionStorage(storageKey, data){
        let storedData = JSON.parse(sessionStorage.getItem(storageKey)),
            key = null;
        for (key in data){
            storedData[key] = data[key];
        }
        sessionStorage.setItem(storageKey, JSON.stringify(storedData));
    };

    function removeSpQuery(urlQuery){
        let queries = null,
            queriesKeeping = null,
            i;
        if (urlQuery){
            urlQuery = urlQuery.substring(1);
            queries = urlQuery.split("&")
            queriesKeeping = [];
            for (i=0; i < queries.length; i++){
                if (queries[i].indexOf("sp=") == -1){
                    queriesKeeping.push(queries[i]);
                }
            }
            urlQuery = "?" + queriesKeeping.join("&");
        }
        return urlQuery
    };

    var NavigationButton = {
        setup: function(direction){
            if (direction == "previous"){
                this.element = document.getElementById("previous-result");
            } else if (direction == "next"){
                this.element = document.getElementById("next-result")
            }
        },
        configure: function(href, index, setNo){
            if (href && (index || index === 0) && setNo){
                this.element.href = href;
                this.element.classList.remove("disabled");
                this.element.addEventListener('click', function(){
                    setSessionStorage("searchResults", {
                        "setIndex": index,
                        "setNumber": setNo
                    });
                });
            }
        }
    };

    var PreviousNextNavigation = {
        setup: function(){
            // Navigation Data
            let searchResults = JSON.parse(sessionStorage.getItem("searchResults"));
            this.searchUrl = sessionStorage.getItem("searchUrl");
            if (searchResults){
                this.resultsTotal = Number(searchResults["total"]);
                this.results = searchResults["results"];
                this.setIndex = Number(searchResults["setIndex"]);
                this.setCount = Number(searchResults["setCount"]);
                this.setNumber = Number(searchResults["setNumber"]);
                // Navigation Buttons
                this.previousNextButtonWrapper = document.getElementById("previous-next-results");
                this.previousButton = Object.create(NavigationButton);
                this.previousButton.setup("previous");
                this.nextButton = Object.create(NavigationButton);
                this.nextButton.setup("next");
            }
        },

        configureNavigation: function(){
            if (this.areResultsInStorage()){
                //Show the button wrapper (buttons are "disabled" for now)
                this.previousNextButtonWrapper.style.display = "inline-block";
                this.configurePrevious();
                this.configureNext();
                this.checkResultSetNeeded();
            }
        },

        areResultsInStorage: function(){
            if (this.results
            && (this.setIndex || this.setIndex === 0)
            && this.setCount
            && this.resultsTotal
            && this.setNumber
            && this.results.hasOwnProperty(this.setNumber)
            && this.results[this.setNumber].length > 0){
                return true;
            } else {
                return false;
            }
        },

        configurePrevious: function(){
            let href = null,
                index = null,
                setNo = null;
            if (this.setIndex == 0){
                if (this.setNumber > 1){
                    setNo = this.setNumber - 1;
                    if (this.results.hasOwnProperty(setNo)){
                        index = this.results[setNo].length - 1;
                        href = this.results[setNo][index];
                    }
                }
            } else {
                setNo = this.setNumber;
                index = this.setIndex - 1;
                href = this.results[setNo][index];
            }
            this.previousButton.configure(href, index, setNo);
        },

        configureNext: function(){
            let href = null,
                index = null,
                setNo = null;
            if (this.setIndex == (this.results[this.setNumber].length - 1)){
                if (!this.inLastResultSet()){
                    setNo = this.setNumber + 1;
                    if (this.results.hasOwnProperty(setNo)){
                        index = 0;
                        href = this.results[setNo][index];
                    }
                }
            } else {
                setNo = this.setNumber;
                index = this.setIndex + 1;
                href = this.results[setNo][index];
            }
            this.nextButton.configure(href, index, setNo);
        },

        inLastResultSet: function(){
            let lastSetNo = this.resultsTotal / this.setCount;
            if ((Number.isInteger(lastSetNo) && this.setNumber == lastSetNo)
            || (!Number.isInteger(lastSetNo) && this.setNumber > lastSetNo)){
                return true;
            } else {
                return false;
            }
        },

        // Deal with hitting the top or bottom of a list of results
        checkResultSetNeeded: function(){
            let setNo = null;
            if (this.setIndex <= 5
            && this.setNumber > 1){
                setNo = this.setNumber - 1;
                if (!this.results.hasOwnProperty(setNo)){
                    this.retrieveResultSet(setNo);
                }
            }
            if (this.setIndex >= this.results[this.setNumber].length - 5
            && !this.inLastResultSet()){
                setNo = this.setNumber + 1;
                if (!this.results.hasOwnProperty(setNo)){
                    this.retrieveResultSet(setNo);
                }
            }
        },

        retrieveResultSet: function(setNo){
            let _this = this,
                url = this.searchUrl,
                parser = null;

            if (url){
                this.results[setNo] = [];
                parser = document.createElement("a");
                parser.href = url;
                parser.search = removeSpQuery(parser.search);
                if (parser.search){
                    url += "&"
                } else {
                    url += "?"
                }
                url += "sp=" + setNo;
                jQuery.ajax({
                    traditional: true,
                    type: "GET",
                    url: url,
                    dataType: "json",
                    success: function(response){
                        for (var i = 0; i < response.results.length; i++){
                            _this.results[setNo].push(response.results[i].url);
                        }

                        //Store the updated results in session storage
                        setSessionStorage("searchResults", {"results": _this.results});

                        // If the previous/next buttons are disabled then try
                        // to turn them on again
                        if (_this.previousButton.element.classList.contains("disabled")){
                            _this.configurePrevious();
                        }
                        if (_this.nextButton.element.classList.contains("disabled")){
                            _this.configureNext();
                        }
                    }
                });
            }
        }
    };
    // Only show the previous and next result buttons if on the resource page
    if (window.location.pathname.substring(0, 10) == "/resource/"){
        var prevNextNavigation = Object.create(PreviousNextNavigation);
        prevNextNavigation.setup();
        prevNextNavigation.configureNavigation();
    } else {
        delete sessionStorage["searchResults"];
    }

});

