    $(document).on('media-player-ready', function(event, media, node){
        var player = node.player,
            clips = $(node)
                .parents('.streaming-resource')
                .find('.media-clips a.media-clip-link');
        var clipBegin,
            clipEnd,
            intervalID;

        if(!clips.length){
            return;
        }
        $(clips).on('click', function(event, options){

            var clip = $(event.currentTarget);

            event.preventDefault();
            if(intervalID){
                clearInterval(intervalID);
                intervalID = null;
            }

            clipBegin = Number($(clip).attr('data-begin'));
            clipEnd = Number($(clip).attr('data-end'));
            intervalID = setInterval(function() {
                var currentTime = player.getCurrentTime();
                if(clipEnd && currentTime >= clipEnd){
                    clipBegin = clipEnd = null;
                    player.pause();
                    player.showControls();
                    clearInterval(intervalID);
                    intervalID = null;
                }
            }, 2000);
            player.setCurrentTime(clipBegin);
            player.play();
            player.showControls();

        });
        return false;
    });
});
