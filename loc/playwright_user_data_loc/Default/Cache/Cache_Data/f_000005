function is_holiday(dt_date){

    // check simple dates (month/date - no leading zeroes)
    var n_date = dt_date.getUTCDate(),
        n_month = dt_date.getUTCMonth() + 1,
        s_date1 = n_month + '/' + n_date;

    if( s_date1 == '1/1' ){
        return "New Year's Day";
    }
    if( s_date1 == '6/14' ){
        return "Flag Day";
    }
    if( s_date1 == '7/4' ){
        return "Independence Day";
    }
    if( s_date1 == '11/11' ){
        return "Veterans Day";
    }
    if( s_date1 == '12/25' ){
        return "Christmas Day";
    }

    // weekday from beginning of the month (month/num/day)
    var n_wday = dt_date.getUTCDay(),
        n_wnum = Math.floor((n_date - 1) / 7) + 1,
        s_date2 = n_month + '/' + n_wnum + '/' + n_wday;

    if( s_date2 == '1/3/1' ){
        // Birthday of Martin Luther King, third Monday in January
        return "MLK Jr. Day";
    }
    if( s_date2 == '2/3/1' ){
        // Washington's Birthday, third Monday in February
        return "President's Day";
    }
    // Not a federal holiday
    // if ( s_date2 == '5/3/6' ){
    //     // Armed Forces Day, third Saturday in May
    //     returned "Armed Forces Day";
    // }
    if( s_date2 == '9/1/1' ){
         // Labor Day, first Monday in September
        return "Labor Day";
    }
    if( s_date2 == '10/2/1' ){
         // Columbus Day, second Monday in October
        return "Columbus Day";
    }
    if( s_date2 == '11/4/4' ){
        // Thanksgiving Day, fourth Thursday in November
        return "Thanksgiving Day";
    }

    // weekday number from end of the month (month/num/day)
    var dt_temp = new Date (dt_date);
    dt_temp.setUTCDate(1);
    dt_temp.setUTCMonth(dt_temp.getUTCMonth() + 1);
    dt_temp.setUTCDate(dt_temp.getUTCDate() - 1);
    n_wnum = Math.floor((dt_temp.getUTCDate() - n_date - 1) / 7) + 1;
    var s_date3 = n_month + '/' + n_wnum + '/' + n_wday;

    // Memorial Day, last Monday in May
    if (s_date3 == '5/1/1') {
        return "Memorial Day";
    }

    // misc complex dates
    if (s_date1 == '1/20'
    && (((dt_date.getUTCFullYear() - 1937) % 4) == 0)){
        // Inauguration Day, January 20th every four years, starting in 1937.
        return "Inauguration Day";
    }

    if (n_month == 11
    && n_date >= 2
    && n_date < 9
    && n_wday == 2
    ) {
        // Election Day, Tuesday on or after November 2.
        return "Election Day";
    };

    return false;
}

