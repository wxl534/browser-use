jQuery(function($){

    var MONTHS = [
        "January",
        "February",
        "March",
        "April",
        "May",
        "June",
        "July",
        "August",
        "September",
        "October",
        "November",
        "December"
    ];

    function zero_pad(n){
        if (n < 10) {
            n = '0' + n;
        }
        return n + '';
    };

    function to_yyyy_mm_dd(selected_date){
        if (selected_date == null){
            return "";
        }
        var day = zero_pad(selected_date.getDate()),
            month = zero_pad(selected_date.getMonth() + 1),
            year = selected_date.getFullYear();
        return [year, month, day].join('-');

    };

    function isValidDate(date_string) {
        var date_string = date_string.split('/');
            date = new Date(date_string[2], date_string[0], date_string[1]);
        return (date &&
                (date.getMonth()) == Number(date_string[0]) &&
                 date.getDate() == Number(date_string[1]) &&
                 date.getFullYear() == Number(date_string[2]));
    };

    function from_yyyy_mm_dd(date_string){
        if(!date_string) return new Date();

        var year = Number(date_string.substring(0,4)),
            month = Number(date_string.substring(5,7)),
            day = Number(date_string.substring(8,11));
        return new Date(year, month - 1, day);
    };

    function to_readable_date(date){
        var day = zero_pad(date.getDate()),
            month = MONTHS[date.getMonth()],
            year = date.getFullYear();
        return month + " " + day + ", " + year;
    };

    function check_date_format(){
        var date_string = $(".q").val();
        if(isValidDate(date_string)){
            return new Date(date_string);
        }
        else{
            return $(".q").datepicker("getDate");
        }
    };

    var date = from_yyyy_mm_dd($("#datepicker").attr("title"));

    // Placeholder to display current date or selected date.
    $('#datepicker')
        .attr("placeholder", to_readable_date(date))
        .on('input', function(event){
            event.target.setCustomValidity('');
        })
        .on('invalid', function(event){
            event.target.setCustomValidity($('#datepicker').attr('title'));
        });

    // Add form validation for readable date format
    $("#datepicker-form").submit(function(event){
        selected_date = check_date_format();
        event.stopPropagation();
        event.preventDefault();
        location.replace("/events/?tz_aware=true&dates=" + to_yyyy_mm_dd(selected_date));
    });

    $('#datepicker').datepicker({
        autoSize: true,
        dateFormat: "MM dd, yy",
        showOn: "button",
        nextText: "Next Month",
        prevText: "Previous Month",
        buttonText: "",
        showButtonPanel: true, // required for datepicker accessible addon
        closeText: 'Close', // required for datepicker accessible addon
        beforeShow: function () {
            $('#datepicker').get(0).setCustomValidity('');
            $('button.ui-datepicker-trigger').attr('aria-pressed', true);
        },
        onClose: function () {
            $(this).focus();
            $('button.ui-datepicker-trigger').attr('aria-pressed', false);
        }
    });

    $('#datepicker').datepicker('setDate', date);

    // Accessible datepicker addon
    // Add aria-describedby to the button referring to the label
    $('.ui-datepicker-trigger').attr('aria-describedby', 'datepickerLabel');
    $('.ui-datepicker-trigger').attr('id', 'datepicker-button-good');

    setupTrigger();
});
