document.addEventListener("DOMContentLoaded", () => {

    'use strict'

    let PORTAL_FORM_URL = LOC_SETTINGS['PORTAL_FORM_URL'],
        PORTAL_FORM_KEY = LOC_SETTINGS['PORTAL_FORM_KEY'],
        KEY_CHECK_INTERVAL = 5 * 1000 * 60, //Five minutes
        $ = jQuery;

    // Example starter JavaScript for disabling form submissions if there are invalid fields
    // Fetch all the forms we want to apply custom Bootstrap validation styles to
    const forms = document.querySelectorAll('.needs-validation')

    if (forms.length){
        // Periodically check for form key/url updates.
        setInterval(update_form_keys, KEY_CHECK_INTERVAL);
    }

    // Loop over them and prevent submission
    Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();

                console.log('Form is invalid, stopping submission');

                // Focus on the first invalid field
                const invalid_input = form.querySelector(':invalid'),
                    invalid_input_id = invalid_input.id,
                    invalid_input_name = invalid_input.name;

                var invalid_div = null;

                if (!invalid_input_name && invalid_input_id.startsWith('div-')){
                    invalid_div = invalid_input;
                } else {
                    invalid_div = form.querySelector('#div-' + invalid_input_name);
                }

                if (!invalid_div){
                    alert('Unknown error submitting form: ' + invalid_input_name);
                } else {
                    invalid_div.focus();
                }
            }
            form.classList.add('was-validated');
        }, false);
    });

    function update_form_keys() {
        fetch('/portals/form-keys/?' + Math.random(), {
            method: 'GET',
            cache: 'no-store'
        })
        .then(response => response.json())
        .then(data => {
            let updated = false;
            if (data) {
                if (PORTAL_FORM_URL !== data.url) {
                    PORTAL_FORM_URL = data.url;
                    updated = true;
                }
                if (PORTAL_FORM_KEY !== data.key) {
                    PORTAL_FORM_KEY = data.key;
                    updated = true;
                }
            }
            if (updated) { alert_key_error(); }
        })
        .catch(error => console.error('Error updating form keys:', error));
    }


