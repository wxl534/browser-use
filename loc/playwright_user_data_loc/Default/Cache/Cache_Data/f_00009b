jQuery(function($){
    let target = document.querySelectorAll('.media-playlist-container, .media-playlist-menu, .mejs__playlist-selected, media-playlist-audio-items, media-playlist-items');
    if(!target.length){return;}

    var registered = false;

    $(document).on('media-player-ready', function(event, media, node){
        var container = $(media).parents('.media-playlist-container'),
            playlist = $('.media-playlist-menu ul li', container),
            current_track = $('.mejs__playlist-selected input', container).get(0),
            current_track_label = current_track.getAttribute('data-playlist-title');

        // Replace default media label
        $(media).closest('.mejs__container').attr('aria-label', current_track_label);

        if(registered){ return; }

        $(playlist).click(function(event){
            var target = $(event.currentTarget),
                clicked_track = $('input', target).get(0);

            if(clicked_track != current_track){
                $(current_track).parents('li').removeClass('mejs__playlist-selected');
                target.addClass('mejs__playlist-selected');
                current_track = $('input', target).get(0);
                play_track($(current_track));
            }
            event.stopPropagation();
            event.preventDefault();
        });
        registered = true;

        function play_track(track){
            var media_type = track.data('playlist-media-type'),
                media_url = track.data('playlist-media-url'),
                media_stream = track.data('playlist-media-stream'),
                title = track.data('playlist-title'),
                id = track.data('playlist-id'),
                closed_captions = track.data('playlist-closed-captions'),
                image = track.data('playlist-image'),
                new_media;

            if('audio' == media_type){
                new_media = $(
                    '<audio' +
                    '   id="' + id + '"' +
                    '   title="' + title + '"' +
                    '   class="media-playlist-audio-player"' +
                    '   controls' +
                    '   crossorigin="anonymous"' +
                    '   preload="auto"' +
                    '   style="width: 100%;"' +
                    '></audio>'
                );
                new_media.append(
                    '<source src="' + media_url + '"' +
                    '   type="audio/mp3"' +
                    '   title="' + title + '"' +
                    '>'
                );
            } else {
                new_media = $(
                    '<video' +
                    '   id="' + id + '"' +
                    '   title="' + title + '"' +
                    '   class="media-playlist-video-player"' +
                    '   controls' +
                    '   crossorigin="anonymous"' +
                    '   preload="metadata"' +
                    '   style="width: 100%; height: 100%;"' +
                    '></video>'
                );
                if(image){
                    new_media.attr('poster', image);
                }
                if(media_stream){
                    new_media.append(
                        '<source src="' + media_stream + '"' +
                        '   type="application/x-mpegURL"' +
                        '   title="' + title + '"' +
                        '>'
                    );
                }
                new_media.append(
                    '<source src="' + media_url + '"' +
                    '   type="video/mp4"' +
                    '   title="' + title + '"' +
                    '>'
                );
                if(closed_captions){
                    new_media.append(
                        '<track kind="captions"' +
                        '    src="' + closed_captions + '"' +
                        '    srclang="en">'
                    );
                }
                // switch the title
                $('.media-playlist-information > div', container).hide();
                $('#' + id + '_info').show();
            }

            $(window).trigger('initialize-playlist', [
                new_media.get(0),
                function(media, node){
                    node.player.play()
                }
            ]);
        }
    });
});

