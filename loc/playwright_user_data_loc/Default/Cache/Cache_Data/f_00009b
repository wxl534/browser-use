document.addEventListener("DOMContentLoaded", () => {
    let target = document.querySelectorAll('#jump-menu');
    if(!target.length){return;}

    function generateTOC() {
        const jumpMenuContainer = document.getElementById('jump-menu');

        // The component allows other criteria instead of h2[id]
        // for example h2:has(a[name])
        let selector = jumpMenuContainer.attributes['data-selector'];
        selector = selector? selector.value : '[id]';

        const headings = document.querySelectorAll(
            `.content h2${selector}, .content h3${selector}, .content h4${selector}, .content h5${selector}`
        );
        let currentLevel = 2; // Starting level (H2)
        let currentList = document.createElement('ul');

        if(jumpMenuContainer === null){
            // No TOC, do nothing.
            return;
        }

        jumpMenuContainer.appendChild(currentList);
        headings.forEach((heading, index) => {
            const level = parseInt(heading.tagName.substring(1));
            const li = document.createElement('li');
            const link = document.createElement('a');

            // Not all legacy markup will have an id on the tag
            // so we look for name. If still nothing we look for a child 'a'
            // tag and like for id and name again
            let anchor = heading.id ?
                heading.id :
                heading.getAttribute('name');
            if (!anchor){
                let heading_link = heading.querySelector('a');
                if(heading_link){
                    anchor = heading_link.id ?
                        heading_link.id :
                        heading_link.getAttribute('name');
                }
                if (!anchor){ return; }
            }

            // Ensure the heading has an ID for linking
            //if (!heading.id) heading.id = `section-${index}`;
            link.href = `#${anchor}`;
            link.textContent = heading.textContent;
            li.appendChild(link);

            if (level > currentLevel) {
                // Nest deeper: create a new list inside the last <li>
                const newList = document.createElement('ul');
                currentList.lastElementChild.appendChild(newList);
                currentList = newList;
            } else if (level < currentLevel) {
                // Go back up: find the parent list
                for (let i = 0; i < currentLevel - level; i++) {
                    currentList = currentList.parentElement.closest('ul');
                }
            }

            currentList.appendChild(li);
            currentLevel = level;
        });
    }

    generateTOC();
});

